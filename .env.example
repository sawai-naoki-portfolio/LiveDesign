# LiveDesign の設定。このファイルを .env にコピーして値を入れる（.env は Git に入れない）。
# Docker で動かすときは、ここにある名前を環境変数として渡す。

# ===== 必須（サービスとして公開するとき） =====
# 外から見たこのサービスの URL。ログインの戻り先と、よそのページからの書き込みを断る判定に使う
PUBLIC_URL=https://livedesign.example.com
# 待ち受けるアドレスとポート（Docker・サーバーでは 0.0.0.0）
HOST=0.0.0.0
PORT=3000
# リバースプロキシ（Caddy・nginx・Cloudflare など）の後ろに置くとき true
TRUST_PROXY=true

# TikTok LIVE のイベントを受けるための署名キー（https://www.eulerstream.com/）。
# 利用者ごとではなく、サービス全体で1つ。同時に繋ぐ人数に合ったプランを選ぶ
EULER_API_KEY=

# ===== ログイン =====
# https で公開しているなら自動で true になる。http で試すときだけ false に
# COOKIE_SECURE=true
# ログインの有効日数
SESSION_DAYS=30
# closed にすると新規登録を止める（招待制にしたいとき・荒らしが来たとき）
REGISTRATION=open

# Google でログイン（空なら出さない）
# 1. https://console.cloud.google.com/apis/credentials で「OAuth クライアント ID」（ウェブ アプリケーション）を作る
# 2. 承認済みのリダイレクト URI に <PUBLIC_URL>/api/auth/google/callback を足す
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok でログイン（空なら出さない。EULER_API_KEY とは別物）
# 1. https://developers.tiktok.com/ でアプリを作り、Login Kit を足す
# 2. Redirect URI に <PUBLIC_URL>/api/auth/tiktok/callback を足す
# 3. user.info.profile の権限も通れば、TIKTOK_SCOPES に足すと @ID を自動で入れられる
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic

# ===== 利用者ごとの上限 =====
MAX_SCENES_PER_USER=50
# クリエイターモードで作るギミック（ゲーム・エフェクト・サウンド）の数
MAX_GIMMICKS_PER_USER=50
STORAGE_QUOTA_MB=500
# 同時に保つ TikTok LIVE の接続の数（同じ @ID は1本。EULER_API_KEY のプランの上限に合わせる）
MAX_LIVE_CONNECTIONS=300

# ===== 保存先 =====
# データベース・素材の置き場所（バックアップするのはここ）
# DATA_DIR=./data

# ===== 開発用 =====
# true にすると TikTok に繋がず、画面を開いている人にダミーのイベントを流す
DEMO_MODE=false
